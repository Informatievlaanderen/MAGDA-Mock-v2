<xsd:schema xmlns="http://magda.vlaanderen.be/milieu-v3" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:bericht="http://generiek-02_00.vip.vlaanderen.be" xmlns:generiek="http://magda.vlaanderen.be/generiek-v3" targetNamespace="http://magda.vlaanderen.be/milieu-v3" elementFormDefault="unqualified" attributeFormDefault="unqualified">
	<xsd:import namespace="http://magda.vlaanderen.be/generiek-v3" schemaLocation="../Generiek/GeneriekDomein-v3.xsd"/>
	<xsd:complexType name="BlacklistMeasurementType">
		<xsd:annotation>
			<xsd:documentation>Container for the Measurements</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="MeasurementId" type="xsd:string">
				<xsd:annotation>
					<xsd:documentation>Unique id for the measurement.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="DateTime" type="xsd:dateTime">
				<xsd:annotation>
					<xsd:documentation>Date of the measurement.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="WeatherCondition" type="BlacklistWeatherConditionType" minOccurs="1" maxOccurs="1"/>
			<xsd:element name="MeasuredVehicle" type="BlacklistMeasuredVehicleType" minOccurs="1" maxOccurs="1">
				<xsd:annotation>
					<xsd:documentation>Container for the list of emissions of the vehicles that were measured.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="BlacklistWeatherConditionType">
		<xsd:annotation>
			<xsd:documentation>Container for the measured weather conditions.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="AirTemperature" type="xsd:float" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Ambient temperature in degrees Celsius.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="BlacklistMeasuredVehicleType">
		<xsd:annotation>
			<xsd:documentation>Container for the measured emission data of the vehicle.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="VIN" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>The VIN number.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Unifier" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>The unifier.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="LicensePlate" type="xsd:string">
				<xsd:annotation>
					<xsd:documentation>Pseudonymized license plate.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="LicensePlateCountryCode" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Country code of the license plate according to ISO 3166-1 alpha-3 standard.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="LicensePlateConfidence" type="xsd:float" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>The confidence percentage of the license plate reading.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
				<xsd:element name="CategoryCode" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>De code van de categorie van het voertuig.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="VehicleType" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Estimation of the vehicle type.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="FuelCode" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Code die het type brandstof van het voertuig aangeeft.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
				<xsd:element name="EuroNormCode" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>De emissienorm waaraan het voertuig voldoet.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
				<xsd:element name="Speed" type="xsd:float" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>The speed of the vehicle in km/h at the time of measurement.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="ExhaustTemperature" type="xsd:float" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>The temperature of the exhaust in degrees Celsius.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="NORatio" type="xsd:float" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>The NO ratio in %</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="NOValidityIndicator" type="xsd:boolean" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Indicates if the NO data is measured correctly (true) or not (false).</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="NO2Ratio" type="xsd:float" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>The NO2 ratio in %.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="NO2ValidityIndicator" type="xsd:boolean" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Indicates if the NO2 data is measured correctly (true) or not (false).</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="PMRatioOpacityBased" type="xsd:float" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Carbon based particle mass in g/kg</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="PMOpacityBasedValidityIndicator" type="xsd:boolean" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Indicates if the PM ratio data is measured correctly (true) or not (false).</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="PNRatio" type="xsd:float" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>The Particle Number emission value</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="PNValidityIndicator" type="xsd:boolean" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Indicates if the PN ratio data is measured correctly (true) or not (false).</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="NH3Ratio" type="xsd:float" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>The NH3 ratio in %.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="NH3ValidityIndicator" type="xsd:boolean" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Indicates if the NH3 data is measured correctly (true) or not (false).</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="NOxRatioGKg" type="xsd:float" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>The NOx ratio in g/Kg.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="PMRatioGKg" type="xsd:float" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>The PM ratio in g/Kg.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ======================== PUBLICATIE TYPES ======================= -->
	<xsd:complexType name="BlacklistType">
		<xsd:sequence>
			<xsd:element name="Measurement" type="BlacklistMeasurementType" minOccurs="0" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>
